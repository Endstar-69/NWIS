# NWIS - Nearby Wells Intelligence System Environment Configuration
APP_NAME=Nearby Wells Intelligence System
APP_ENV=development
DEBUG=True
API_PREFIX=/api
SECRET_KEY=nwis_oil_india_hackathon_super_secret_jwt_key_2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (Defaults to SQLite for instant zero-config execution; PostgreSQL/PostGIS supported)
DATABASE_URL=sqlite:///./data/nwis.db

# Vector / Embeddings / LLM Config
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
AI_DEMO_MODE=True
OPENAI_API_KEY=
GEMINI_API_KEY=your_gemini_api_key_here
